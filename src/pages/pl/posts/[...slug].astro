---
import { getCollection, render } from 'astro:content';
import PostLayout from '../../../layouts/PostLayout.astro';
import { getPostBaseSlug } from '../../../lib/i18n';

export async function getStaticPaths() {
  const posts = await getCollection('posts', ({ data }) => data.lang === 'pl' && !data.draft);
  return posts.map((post) => ({
    params: { slug: getPostBaseSlug(post.id) },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content, headings, remarkPluginFrontmatter } = await render(post);

const coverSrc = post.data.cover?.image
  ? (post.data.cover.image as unknown as ImageMetadata).src
  : undefined;
---

<PostLayout
  title={post.data.title}
  date={post.data.date}
  showToc={post.data.ShowToc}
  showReadingTime={post.data.ShowReadingTime}
  minutesRead={remarkPluginFrontmatter.minutesRead}
  math={post.data.math}
  coverSrc={coverSrc}
  headings={headings}
>
  <Content />
</PostLayout>
