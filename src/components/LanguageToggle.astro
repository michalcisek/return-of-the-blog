---
import { getLangFromUrl, getAlternateUrl } from '../lib/i18n';

const lang = getLangFromUrl(Astro.url.pathname);
const alternateUrl = getAlternateUrl(Astro.url.pathname);
---

<div class="lang-toggle">
  <a
    href={lang === 'en' ? '#' : alternateUrl}
    class:list={['lang-option', { active: lang === 'en' }]}
    aria-label="English"
    aria-current={lang === 'en' ? 'true' : undefined}
  >
    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="16" viewBox="0 0 60 30">
      <rect width="60" height="30" fill="#012169"/>
      <path d="M0,0 L60,30 M60,0 L0,30" stroke="#fff" stroke-width="6"/>
      <path d="M0,0 L60,30 M60,0 L0,30" stroke="#C8102E" stroke-width="2"/>
      <path d="M30,0 V30 M0,15 H60" stroke="#fff" stroke-width="10"/>
      <path d="M30,0 V30 M0,15 H60" stroke="#C8102E" stroke-width="6"/>
    </svg>
  </a>
  <a
    href={lang === 'pl' ? '#' : alternateUrl}
    class:list={['lang-option', { active: lang === 'pl' }]}
    aria-label="Polski"
    aria-current={lang === 'pl' ? 'true' : undefined}
  >
    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="16" viewBox="0 0 8 5">
      <rect width="8" height="5" fill="#dc143c"/>
      <rect width="8" height="2.5" fill="#fff"/>
    </svg>
  </a>
</div>
