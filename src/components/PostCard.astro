---
import type { Lang } from '../lib/i18n';

interface Props {
  title: string;
  date: Date;
  slug: string;
  coverSrc?: string;
  lang?: Lang;
}

const { title, date, slug, coverSrc, lang = 'en' } = Astro.props;
const prefix = lang === 'pl' ? '/pl' : '';

const formattedDate = date.toLocaleDateString(lang === 'pl' ? 'pl-PL' : 'en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
---

<article class="post-card">
  <a href={`${prefix}/posts/${slug}/`}>
    {coverSrc && <img class="post-card-cover" src={coverSrc} alt={title} loading="lazy" />}
    <div class="post-card-body">
      <h2 class="post-card-title">{title}</h2>
      <time class="post-card-date" datetime={date.toISOString()}>{formattedDate}</time>
    </div>
  </a>
</article>
