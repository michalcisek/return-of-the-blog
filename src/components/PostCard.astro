---
interface Props {
  title: string;
  date: Date;
  slug: string;
  coverSrc?: string;
}

const { title, date, slug, coverSrc } = Astro.props;

const formattedDate = date.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
---

<article class="post-card">
  <a href={`/posts/${slug}/`}>
    {coverSrc && <img class="post-card-cover" src={coverSrc} alt={title} loading="lazy" />}
    <div class="post-card-body">
      <h2 class="post-card-title">{title}</h2>
      <time class="post-card-date" datetime={date.toISOString()}>{formattedDate}</time>
    </div>
  </a>
</article>
